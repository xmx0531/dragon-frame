<Window x:Class="DragonFrame.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="小龙娘相框 · 设置" Icon="dragon.ico"
        Width="560" Height="680" MinWidth="520" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False" Topmost="True"
        Background="#FFF7F5FA" FontFamily="Microsoft YaHei UI" FontSize="13">
    <Window.Resources>
        <Style TargetType="TextBox">
    <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#FF302844"/>
    <Setter Property="BorderBrush" Value="#FFCFC6DC"/><Setter Property="BorderThickness" Value="1"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="MinHeight" Value="34"/>
    <Setter Property="Padding" Value="8,5"/>
    <Style.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="#FF675397"/></Trigger></Style.Triggers>
</Style>
<Style TargetType="ComboBox">
    <Setter Property="Foreground" Value="#FF302844"/>
    <Setter Property="MinHeight" Value="34"/>
    <Setter Property="Template">
        <Setter.Value>
            <ControlTemplate TargetType="ComboBox">
                <Grid>
                    <Border x:Name="Outer" Background="White" BorderBrush="#FFCFC6DC" BorderThickness="1" CornerRadius="5" MinHeight="{TemplateBinding MinHeight}">
                        <Grid>
                            <ContentPresenter Margin="10,0,30,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                            <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                                Data="M 0,0 L 4,4 L 8,0" Stroke="#FF675397" StrokeThickness="1.5"/>
                        </Grid>
                    </Border>
                    <ToggleButton Focusable="False" Background="Transparent" BorderThickness="0"
                        IsChecked="{Binding IsDropDownOpen,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"/></ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>
                    <Popup x:Name="PART_Popup" Placement="Bottom" PlacementTarget="{Binding ElementName=Outer}"
                        IsOpen="{Binding IsDropDownOpen,RelativeSource={RelativeSource TemplatedParent}}"
                        AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                        <Border Background="White" BorderBrush="#FFCFC6DC" BorderThickness="1" CornerRadius="5"
                            MinWidth="{Binding ActualWidth,ElementName=Outer}" MaxHeight="260">
                            <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </Border>
                    </Popup>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Outer" Property="BorderBrush" Value="#FF9D8AB8"/></Trigger>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Outer" Property="BorderBrush" Value="#FF675397"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Outer" Property="Opacity" Value="0.55"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value>
    </Setter>
</Style>
<Style TargetType="ComboBoxItem">
    <Setter Property="Padding" Value="10,7"/>
    <Setter Property="Foreground" Value="#FF302844"/>
</Style>
<Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="#FF302844"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
        <Setter.Value>
            <ControlTemplate TargetType="CheckBox">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="Box" Width="16" Height="16" Background="White" BorderBrush="#FFBFB3CE" BorderThickness="1" CornerRadius="4">
                        <TextBlock x:Name="Mark" Text="✓" Visibility="Collapsed" Foreground="White" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                    </Border>
                    <ContentPresenter ContentSource="Content" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="#FF675397"/><Setter TargetName="Box" Property="BorderBrush" Value="#FF675397"/><Setter TargetName="Mark" Property="Visibility" Value="Visible"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value>
    </Setter>
</Style>
<Style TargetType="Slider">
    <Setter Property="Foreground" Value="#FF675397"/>
    <Setter Property="Background" Value="#FFE7DFF0"/>
    <Setter Property="Height" Value="24"/>
    <Setter Property="Template">
        <Setter.Value>
            <ControlTemplate TargetType="Slider">
                <Grid VerticalAlignment="Center" Height="24">
                    <Border Height="4" Background="#FFE7DFF0" CornerRadius="2" VerticalAlignment="Center"/>
                    <Track x:Name="PART_Track" VerticalAlignment="Center">
                        <Track.DecreaseRepeatButton>
                            <RepeatButton Command="Slider.DecreaseLarge" Background="#FF675397" BorderThickness="0">
                                <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="{TemplateBinding Background}" Height="4" CornerRadius="2"/></ControlTemplate></RepeatButton.Template>
                            </RepeatButton>
                        </Track.DecreaseRepeatButton>
                        <Track.Thumb>
                            <Thumb Width="16" Height="16">
                                <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="White" BorderBrush="#FF675397" BorderThickness="2" CornerRadius="8"/></ControlTemplate></Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton Command="Slider.IncreaseLarge" Background="Transparent" BorderThickness="0">
                                <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" Height="12"/></ControlTemplate></RepeatButton.Template>
                            </RepeatButton>
                        </Track.IncreaseRepeatButton>
                    </Track>
                </Grid>
            </ControlTemplate>
        </Setter.Value>
    </Setter>
</Style><Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#FF302844"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF716B7A"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="QuietButton" TargetType="Button">
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Background" Value="#FFF0EBF7"/>
            <Setter Property="Foreground" Value="#FF46365E"/>
            <Setter Property="BorderBrush" Value="#FFD8CFE4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
            <Setter Property="Background" Value="#FF675397"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF675397"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabFace" Background="#FFECE8F2" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <TextBlock x:Name="HeaderText" Text="{TemplateBinding Header}" Foreground="#FF302844" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabFace" Property="Background" Value="#FF675397"/>
                                <Setter TargetName="HeaderText" Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabFace" Property="BorderBrush" Value="#FF9D8AB8"/>
                                <Setter TargetName="TabFace" Property="BorderThickness" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="22,18,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="2,0,0,18">
            <TextBlock Text="设置你的相框" FontSize="22" FontWeight="SemiBold" Foreground="#FF302844"/>
            <TextBlock Text="内容、大小和切换节奏，都在这里调整。" Style="{StaticResource Hint}" Margin="0,4,0,0"/>
        </StackPanel>
        <TabControl x:Name="SettingsTabs" Grid.Row="1" BorderThickness="0" Background="Transparent" SelectedIndex="0">
            <TabItem Header="播放内容">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="2,18,2,8">
                        <Border Background="White" BorderBrush="#FFE7E1EC" BorderThickness="1" CornerRadius="10" Padding="16">
                            <StackPanel>
                                <TextBlock Text="图片 / GIF 文件夹" Style="{StaticResource SectionTitle}"/>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="选择…" Style="{StaticResource QuietButton}" Margin="8,0,0,0" Click="Browse"/>
                                    <TextBox x:Name="FolderBox" VerticalContentAlignment="Center" Padding="8,6"/>
                                </DockPanel>
                                <TextBlock Text="添加新图片后自动加入轮播，只读取这一层。" Style="{StaticResource Hint}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="White" BorderBrush="#FFE7E1EC" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="视频文件夹" Style="{StaticResource SectionTitle}"/>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="选择…" Style="{StaticResource QuietButton}" Margin="8,0,0,0" Click="BrowseVideo"/>
                                    <TextBox x:Name="VideoFolderBox" VerticalContentAlignment="Center" Padding="8,6"/>
                                </DockPanel>
                                <TextBlock Text="支持 MP4；视频播完再换下一项。" Style="{StaticResource Hint}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="White" BorderBrush="#FFE7E1EC" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="轮播哪些内容" Style="{StaticResource SectionTitle}"/>
                                <ComboBox x:Name="MediaModeBox" SelectedIndex="0" Padding="8,5">
                                    <ComboBoxItem Content="只播图片 / GIF（推荐）" Tag="Images"/>
                                    <ComboBoxItem Content="只播视频" Tag="Videos"/>
                                    <ComboBoxItem Content="图片和视频混播" Tag="Mixed"/>
                                </ComboBox>
                                <TextBlock Text="大量短视频连续切换会使内存明显升高；日常建议只播图片 / GIF。" Style="{StaticResource Hint}" Margin="0,9,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="相框外观">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="2,18,2,8">
                        <Border Background="White" BorderBrush="#FFE7E1EC" BorderThickness="1" CornerRadius="10" Padding="16">
                            <StackPanel>
                                <TextBlock Text="固定相框大小" Style="{StaticResource SectionTitle}"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="宽" VerticalAlignment="Center"/>
                                    <TextBox x:Name="WidthBox" Width="70" Margin="7,0,16,0" Padding="6"/>
                                    <TextBlock Text="高" VerticalAlignment="Center"/>
                                    <TextBox x:Name="HeightBox" Width="70" Margin="7,0,14,0" Padding="6"/>
                                    <Button x:Name="PreviewButton" Content="预览边框" Style="{StaticResource QuietButton}" Click="Preview"/>
                                </StackPanel>
                                <WrapPanel Margin="0,12,0,0">
                                    <Button Content="小 · 240×240" Tag="240,240" Style="{StaticResource QuietButton}" Margin="0,0,8,0" Click="Preset"/>
                                    <Button Content="中 · 320×320" Tag="320,320" Style="{StaticResource QuietButton}" Margin="0,0,8,0" Click="Preset"/>
                                    <Button Content="大 · 450×350" Tag="450,350" Style="{StaticResource QuietButton}" Click="Preset"/>
                                </WrapPanel>
                                <TextBlock Text="换图不会改变相框大小；鼠标移上去能看到虚线边框。" Style="{StaticResource Hint}" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="White" BorderBrush="#FFE7E1EC" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="图片放在哪个位置" Style="{StaticResource SectionTitle}"/>
                                <ComboBox x:Name="AnchorBox" SelectedIndex="1" Padding="8,5">
                                    <ComboBoxItem Content="左上角" Tag="TopLeft"/>
                                    <ComboBoxItem Content="右上角" Tag="TopRight"/>
                                    <ComboBoxItem Content="居中" Tag="Center"/>
                                    <ComboBoxItem Content="左下角" Tag="BottomLeft"/>
                                    <ComboBoxItem Content="右下角" Tag="BottomRight"/>
                                </ComboBox>
                                <CheckBox x:Name="EnlargeBox" Content="小图也尽量放大" Margin="0,12,0,0"/>
                                <TextBlock Text="始终保持图片原比例，完整显示，不会超出相框。" Style="{StaticResource Hint}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="锁定后鼠标可穿过相框；双击托盘小龙娘图标解锁。" Style="{StaticResource Hint}" Margin="4,14,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="切换与声音">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="2,18,2,8">
                        <Border Background="White" BorderBrush="#FFE7E1EC" BorderThickness="1" CornerRadius="10" Padding="16">
                            <StackPanel>
                                <TextBlock Text="每张图片停留多久" Style="{StaticResource SectionTitle}"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBox x:Name="IntervalValueBox" Width="90" Padding="7" Margin="0,0,8,0"/>
                                    <ComboBox x:Name="IntervalUnitBox" Width="110" SelectedIndex="1" Padding="5">
                                        <ComboBoxItem Content="秒" Tag="1"/>
                                        <ComboBoxItem Content="分钟" Tag="60"/>
                                        <ComboBoxItem Content="小时" Tag="3600"/>
                                    </ComboBox>
                                </StackPanel>
                                <WrapPanel Margin="0,12,0,0">
                                    <Button Content="1 分钟" Tag="60" Style="{StaticResource QuietButton}" Margin="0,0,8,0" Click="TimePreset"/>
                                    <Button Content="3 分钟" Tag="180" Style="{StaticResource QuietButton}" Margin="0,0,8,0" Click="TimePreset"/>
                                    <Button Content="5 分钟" Tag="300" Style="{StaticResource QuietButton}" Margin="0,0,8,0" Click="TimePreset"/>
                                    <Button Content="10 分钟" Tag="600" Style="{StaticResource QuietButton}" Click="TimePreset"/>
                                </WrapPanel>
                                <TextBlock Text="也可自己填，例如 45 秒或 2.5 分钟。视频会播完再换。" Style="{StaticResource Hint}" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="White" BorderBrush="#FFE7E1EC" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="视频播放" Style="{StaticResource SectionTitle}"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="速度" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <ComboBox x:Name="VideoSpeedBox" Width="110" Padding="5">
                                        <ComboBoxItem Content="0.5×" Tag="0.5"/>
                                        <ComboBoxItem Content="1×" Tag="1"/>
                                        <ComboBoxItem Content="1.5×" Tag="1.5"/>
                                        <ComboBoxItem Content="2×" Tag="2"/>
                                    </ComboBox>
                                </StackPanel>
                                <CheckBox x:Name="VideoAudioBox" Content="播放视频声音" Margin="0,14,0,10"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="音量" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <Slider x:Name="VideoVolumeSlider" Width="225" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="VideoVolumeChanged" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="VideoVolumeText" Width="44" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="声音默认关闭，也能从相框按钮或托盘随时开关。" Style="{StaticResource Hint}" Margin="0,9,0,0"/>
                            </StackPanel>
                        </Border>
                        <Button x:Name="RestoreExcludedButton" Content="恢复不参与轮播的图片" Style="{StaticResource QuietButton}" Click="RestoreExcluded" HorizontalAlignment="Left" Margin="0,14,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        <Border Grid.Row="2" BorderBrush="#FFE2DCE8" BorderThickness="0,1,0,0" Margin="0,14,0,0" Padding="0,14,0,0">
            <Grid>
                <TextBlock x:Name="ErrorText" Foreground="#FFB04453" TextWrapping="Wrap" VerticalAlignment="Center" Margin="2,0,170,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消" Style="{StaticResource QuietButton}" MinWidth="76" Margin="0,0,8,0" IsCancel="True"/>
                    <Button x:Name="SaveButton" Content="保存设置" Style="{StaticResource PrimaryButton}" MinWidth="96" Click="Save" IsDefault="True"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>






