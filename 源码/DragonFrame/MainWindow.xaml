<Window x:Class="DragonFrame.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" InputMethod.IsInputMethodEnabled="False" Title="小龙娘相框" Width="300" Height="200" MinWidth="100" MinHeight="80" MaxWidth="800" MaxHeight="600" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" Topmost="True" ShowInTaskbar="False" Icon="dragon.ico" SizeChanged="FrameSizeChanged">
<Grid x:Name="FrameRoot" Background="#01000000" MouseLeftButtonDown="DragFrame" MouseEnter="FrameEnter" MouseLeave="FrameLeave">
<Grid.Resources>
<Style x:Key="ChromeButton" TargetType="Button">
<Setter Property="Width" Value="26"/><Setter Property="Height" Value="30"/><Setter Property="Margin" Value="0"/><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="16"/><Setter Property="Cursor" Value="Hand"/>
<Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ButtonFace" Background="{TemplateBinding Background}" CornerRadius="4"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonFace" Property="Background" Value="#FF555555"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonFace" Property="Background" Value="#FF777777"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
</Style>
<Style x:Key="FrameContextMenu" TargetType="ContextMenu">
<Setter Property="Background" Value="#FFFCFAFE"/><Setter Property="BorderBrush" Value="#FFB8A9C9"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="5"/><Setter Property="FontFamily" Value="Microsoft YaHei UI"/><Setter Property="FontSize" Value="13"/>
</Style>
<Style x:Key="FrameMenuItem" TargetType="MenuItem">
<Setter Property="Foreground" Value="#FF302844"/><Setter Property="Background" Value="Transparent"/><Setter Property="MinHeight" Value="32"/><Setter Property="Cursor" Value="Hand"/>
<Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem"><Border x:Name="Face" Background="{TemplateBinding Background}" CornerRadius="5" Margin="1"><Grid MinWidth="228"><Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock x:Name="Tick" Text="✓" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FF675397" FontWeight="Bold"/><ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" Margin="4,0,14,0"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Face" Property="Background" Value="#FFEDE7F5"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
</Style></Grid.Resources>
<Image x:Name="Picture" Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Top" IsHitTestVisible="False"/>
<MediaElement x:Name="VideoPlayer" Visibility="Collapsed" Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Top" LoadedBehavior="Manual" UnloadedBehavior="Stop" IsMuted="True" IsHitTestVisible="False" MediaOpened="VideoOpened" MediaEnded="VideoEnded" MediaFailed="VideoFailed"/>
<Rectangle x:Name="FrameOutline" Visibility="Collapsed" Margin="1" Stroke="#FF36D9FF" StrokeThickness="1.5" StrokeDashArray="5,3" IsHitTestVisible="False"/>
<TextBlock x:Name="Status" Foreground="White" Background="#C0202020" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8"/>
<Border x:Name="HoverToolbar" Visibility="Collapsed" VerticalAlignment="Top" HorizontalAlignment="Right" Background="#EB30263F" BorderBrush="#AA8C79AA" BorderThickness="1" CornerRadius="8" Padding="4" Margin="3">
<WrapPanel Orientation="Horizontal">
<Button x:Name="PreviousButton" Style="{StaticResource ChromeButton}" Content="◀" ToolTip="上一张" IsEnabled="False" Click="PreviousClicked"/>
<Button x:Name="NextButton" Style="{StaticResource ChromeButton}" Content="▶" ToolTip="下一张（并重新计时）" Click="NextClicked"/>
<Button x:Name="VideoAudioButton" Style="{StaticResource ChromeButton}" Content="♪" ToolTip="开关视频声音" Visibility="Collapsed" Click="VideoAudioClicked"/>
<Button x:Name="SettingsButton" Style="{StaticResource ChromeButton}" Content="⚙" ToolTip="设置目录、间隔和大小" Click="SettingsClicked"/>
<Button x:Name="LockButton" Style="{StaticResource ChromeButton}" Content="锁" ToolTip="锁定并让鼠标穿透；托盘双击解锁" Click="LockClicked"/>
<Button x:Name="HideButton" Style="{StaticResource ChromeButton}" Content="—" ToolTip="隐藏；托盘双击恢复" Click="HideClicked"/>
</WrapPanel></Border>
<Border x:Name="HoverInfo" Visibility="Collapsed" VerticalAlignment="Bottom" Background="#E830263F" CornerRadius="6" Padding="7,5" Margin="3,0,3,27" IsHitTestVisible="False"><TextBlock x:Name="TimingText" Foreground="White" FontSize="11" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/></Border>
<Thumb x:Name="ResizeGrip" Width="24" Height="24" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" Visibility="Collapsed" ToolTip="拖动调节大小（最大 800×600）；设置中可输入宽高" DragDelta="ResizeFrame" DragCompleted="ResizeFinished"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#E830263F" CornerRadius="6"><Path Data="M 7,19 L 19,7 M 12,19 L 19,12 M 17,19 L 19,17" Stroke="White" StrokeThickness="2"/></Border></ControlTemplate></Thumb.Template></Thumb>
</Grid></Window>



